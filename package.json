{
  "name": "qrpc-results",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "dev": "vite",
    "build": "node scripts/build-id.mjs && vite build",
    "preview": "npm run build && wrangler pages dev dist --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply qrpc-results --local",
    "db:migrate:remote": "wrangler d1 migrations apply qrpc-results --remote",
    "worker:deploy": "cd worker && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250617.0",
    "@tailwindcss/vite": "4.1.10",
    "@types/node": "22.20.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "@vitest/coverage-v8": "3.2.4",
    "tailwindcss": "4.1.10",
    "typescript": "5.9.3",
    "vite": "6.3.5",
    "vitest": "3.2.4",
    "wrangler": "4.20.0"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router": "7.6.2"
  }
}

# Copy to .dev.vars for local development (never commit .dev.vars).
SESSION_SECRET=change-me-to-a-long-random-string
# Local only: act as this admin on localhost when Cloudflare Access is not configured.
DEV_ADMIN_EMAIL=you@example.com
# Production (set as Pages secrets/variables, not here):
# ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# ACCESS_AUD=<Application Audience (AUD) tag from the Access application>
